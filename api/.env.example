# 鵲太醫 API 环境变量模板 —— 复制为 .env 并填入真实值，.env 绝不入 git
NODE_ENV=development
PORT=3000

# MySQL 系统库（生产：自建 Linux MySQL 8；本地可用 MariaDB 兼容）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=quetaiyiai
DB_PASSWORD=replace_with_db_password
DB_NAME=quetaiyiai
DB_POOL_LIMIT=10

# 安全密钥（务必替换为随机值！生成：openssl rand -hex 32）
JWT_SECRET=replace_with_64_hex_chars
KEY_ENCRYPTION_KEY=replace_with_64_hex_chars_32bytes
PASSWORD_PEPPER=replace_with_random_string

# 飞书（平台默认机器人，阶段 4 用；租户级凭证在系统设置里绑定入库）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 域名（部署时替换）
DOMAIN=your-domain.com
