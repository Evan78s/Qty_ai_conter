# 鵲太醫 · Docker 部署配置
# 复制为 docker/.env 后按需修改。install.sh 会自动生成，一般不用手动改。

# 对外 HTTP 端口（有 HTTPS 反代时可改为其它，如 8080）
HTTP_PORT=80

# MySQL 系统库（容器内，数据持久化到卷）
MYSQL_DATABASE=yangyuanhui
MYSQL_USER=qty
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_PASSWORD=change_me_db_password

# 管理员（首次自动建；install.sh 会覆盖为你输入的值）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
ADMIN_NAME=总管理员
